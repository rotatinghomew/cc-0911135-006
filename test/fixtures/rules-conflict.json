{
  "ruleVersion": "rules-test-conflict",
  "description": "测试专用：同一表命中两条互斥规则，用于验证冲突时阻断而非任取第一条。",
  "tables": [
    {
      "id": "nickel-table-A",
      "match": { "tableId": "assays" },
      "element": "Ni",
      "headers": {
        "material": { "paths": [["材料号"]], "required": true },
        "part": { "paths": [["部位"]], "required": true },
        "value": { "paths": [["Ni", "结果"]], "required": true },
        "unit": { "paths": [["Ni", "单位"]], "required": true },
        "state": { "paths": [["状态"]], "required": true }
      },
      "unit": {
        "target": "mg/kg",
        "accept": [{ "unit": "mg/kg", "factor": 1 }],
        "onConflict": "quarantine-row",
        "onMissing": "quarantine-row"
      },
      "stateMap": { "有效": "valid", "撤回": "withdrawn", "未检": "not-tested" },
      "footnotes": { "verifyBelowLimit": false }
    },
    {
      "id": "nickel-table-B",
      "match": { "tableId": "assays" },
      "element": "Ni",
      "headers": {
        "material": { "paths": [["材料号"]], "required": true },
        "part": { "paths": [["部位"]], "required": true },
        "value": { "paths": [["Ni", "结果"]], "required": true },
        "unit": { "paths": [["Ni", "单位"]], "required": true },
        "state": { "paths": [["状态"]], "required": true }
      },
      "unit": {
        "target": "mg/kg",
        "accept": [{ "unit": "mg/kg", "factor": 1 }],
        "onConflict": "quarantine-row",
        "onMissing": "quarantine-row"
      },
      "stateMap": { "有效": "valid", "撤回": "withdrawn", "未检": "not-tested" },
      "footnotes": { "verifyBelowLimit": false }
    }
  ]
}
